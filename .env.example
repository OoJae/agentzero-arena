# ─────────────────────────────────────────────────────────────────────────────
# AgentZero Arena — environment
# Copy to `.env` (git-ignored) and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic — used by the agent decision engine (worker/decide.ts).
# If unset, the worker falls back to a deterministic heuristic so the arena
# still runs. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Kraken API — LIVE FINALE ONLY. The entire paper tournament needs NO credentials.
# Use a LEAST-PRIVILEGE key: trading ON, WITHDRAWALS OFF. Leave blank for paper mode.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ─── Arena configuration (safe defaults; override as needed) ──────────────────

# Isolation provider for paper portfolios:
#   paper-cli  → real `kraken paper` per-agent via HOME override (needs Kraken network)
#   virtual    → simulate fills from a price feed (works offline)
ARENA_ISOLATION_PROVIDER=paper-cli

# Price feed source:
#   live    → `kraken ws/ticker` (requires *.kraken.com reachable)
#   replay  → deterministic offline feed (for dev/demo where Kraken is blocked)
ARENA_PRICE_FEED=live

# Per-agent CLI config roots live here (each agent gets its own $HOME subdir).
ARENA_DATA_DIR=./data

# Seconds between agent decision ticks (staggered across agents).
ARENA_TICK_SECONDS=20

# Claude model for agent decisions.
ARENA_AGENT_MODEL=claude-sonnet-4-6
