# ─────────────────────────────────────────────────────────────────────────────
# AgentZero Arena — environment
# Copy to `.env` (git-ignored) and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Agent decision model (worker/decide.ts) ────────────────────────────────
# Anthropic-SDK-compatible. If ANTHROPIC_API_KEY is unset, the worker falls back
# to a deterministic heuristic so the arena still runs.
ANTHROPIC_API_KEY=

# Model + (optional) base URL. Leave ANTHROPIC_BASE_URL blank for real Anthropic.
#   Real Anthropic:  ARENA_AGENT_MODEL=claude-sonnet-4-6   (ANTHROPIC_BASE_URL blank)
#   MiMo (example):  ARENA_AGENT_MODEL=mimo-v2.5-pro
#                    ANTHROPIC_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic
# NOTE: MiMo's plan is for interactive/agent-tool use; an always-on worker is an
# "automated backend" per their terms — for the final recorded/submitted demo,
# consider a real Anthropic key to avoid any key revocation mid-judging.
ARENA_AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=
# MiMo v2.5 is a reasoning model; a small token cap truncates the decision.
ARENA_MAX_TOKENS=2048

# ─── Kraken API — LIVE FINALE ONLY ──────────────────────────────────────────
# The entire paper tournament needs NO credentials. The wrapper STRIPS these from
# every paper/market call (finale-only). Use a LEAST-PRIVILEGE key: trading ON,
# WITHDRAWALS OFF. Leave blank for paper mode.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ─── Arena configuration (safe defaults; override as needed) ────────────────

# Isolation provider for paper portfolios:
#   paper-cli  → real `kraken paper` / `kraken futures paper` per-agent via HOME (needs Kraken network)
#   virtual    → simulate fills from a price feed (works offline)
ARENA_ISOLATION_PROVIDER=paper-cli

# Price feed source:
#   live    → `kraken ticker/ohlc/futures ticker` (requires *.kraken.com reachable)
#   replay  → deterministic offline feed (for dev/demo where Kraken is blocked)
ARENA_PRICE_FEED=live

# Per-agent CLI config roots live here (each agent gets its own $HOME subdir).
ARENA_DATA_DIR=./data

# Seconds between agent decision ticks (staggered across agents). With a slow
# reasoning model (MiMo), prefer 20–40s so LLM latency doesn't stall the loop.
ARENA_TICK_SECONDS=20

# OHLC candle interval (minutes) used for feature windows.
ARENA_OHLC_INTERVAL=15

# Clear the DISPLAY event log (BENCH/VETO/LIVE_FINALE) + transient finale state on each
# worker boot, so a restart = clean slate for a demo. The tamper-evident audit chain is
# NEVER wiped. Set to 0/false to preserve events across restarts. Default: on.
ARENA_RESET_EVENTS_ON_BOOT=1
